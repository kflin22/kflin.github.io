---
---

<div class="site-paper" id="{{ entry.key | escape }}">
  <div class="abbr">
    {% if entry.abbr %}
      <abbr class="badge rounded w-100" title="{{ entry.journal | escape }}">{{ entry.abbr | escape }}</abbr>
    {% endif %}
    <div class="site-paper-files">
      {% if entry.pdf %}
        {% assign pdf_url = entry.pdf %}
        {% unless pdf_url contains '://' %}
          {% assign pdf_url = pdf_url | prepend: '/assets/pdf/' | relative_url %}
        {% endunless %}
        <a href="{{ pdf_url | escape }}" aria-label="Article PDF">
          <i class="fa-regular fa-file-pdf" aria-hidden="true"></i> PDF
        </a>
      {% endif %}
      {% if entry.supp %}
        {% assign supp_url = entry.supp %}
        {% unless supp_url contains '://' %}
          {% assign supp_url = supp_url | prepend: '/assets/pdf/' | relative_url %}
        {% endunless %}
        <a href="{{ supp_url | escape }}" aria-label="Supplementary Information">
          <i class="fa-solid fa-paperclip" aria-hidden="true"></i> SI
        </a>
      {% endif %}
    </div>
  </div>
  <div>
    <div class="title">
      {% if entry.url %}
        <a href="{{ entry.url | escape }}">{{ entry.title | escape }}</a>
      {% else %}
        {{ entry.title | escape }}
      {% endif %}
    </div>
    <div class="periodical">
      {% if entry.journal %}<em>{{ entry.journal | escape }}</em>,{% endif %}
      {% if entry.date %}
        {{ entry.date | date: '%B %Y' }}
      {% else %}
        {{ entry.month | capitalize | escape }} {{ entry.year | escape }}
      {% endif %}
    </div>
    {% if site.enable_publication_badges.dimensions and entry.dimensions == 'true' and entry.doi %}
      <div class="badges">
        <span class="__dimensions_badge_embed__" data-doi="{{ entry.doi | escape }}" data-style="small_rectangle" data-legend="hover-right"></span>
      </div>
    {% endif %}
  </div>
</div>
